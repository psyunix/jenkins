# Use official Jenkins LTS image
FROM jenkins/jenkins:lts

# Switch to root to install additional packages if needed
USER root

# Install Docker CLI to allow Jenkins to run Docker commands
RUN apt-get update && \
    apt-get install -y docker.io && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add jenkins user to docker group
RUN usermod -aG docker jenkins

# Create an entrypoint script to fix socket permissions on startup
RUN printf '#!/bin/bash\n' > /entrypoint.sh && \
    printf 'if [ -S /var/run/docker.sock ]; then\n' >> /entrypoint.sh && \
    printf '  chmod 666 /var/run/docker.sock 2>/dev/null || true\n' >> /entrypoint.sh && \
    printf 'fi\n' >> /entrypoint.sh && \
    printf 'exec /usr/local/bin/jenkins.sh "$@"\n' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

# Switch back to jenkins user
USER jenkins

# Expose Jenkins port
EXPOSE 8080
EXPOSE 50000

# Jenkins home directory
VOLUME /var/jenkins_home

# Use custom entrypoint to fix socket permissions
ENTRYPOINT ["/entrypoint.sh"]
